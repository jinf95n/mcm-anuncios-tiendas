{
  "$schema": "node_modules/wrangler/config-schema.json",
  // IMPORTANTE: cambiar por el slug del cliente antes del primer deploy
  // (si no, pisa el deploy de otro proyecto).
  "name": "take-one",
  // worker.ts envuelve .open-next/worker.js para servir /media/* con Range (206).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Los videos pasan primero por worker.ts (pedidos parciales para Safari/iPhone).
    "run_worker_first": ["/media/*"]
  },
  "observability": { "enabled": true }
}
